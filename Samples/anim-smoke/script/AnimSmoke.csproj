<Project Sdk="Microsoft.NET.Sdk">
  <!-- AnimSmoke：anim-smoke 的"用户脚本程序集"（档① FrameScript 换帧视觉验收）。
       经 Collectible ALC 从路径加载（与 Lemon.Entry 无引用关系，分层同 BenchScript）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>AnimSmoke</AssemblyName>
    <RootNamespace>AnimSmoke</RootNamespace>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Engine/Scripting/dotnet/Lemon.SDK/Lemon.SDK.csproj" />
  </ItemGroup>
</Project>
