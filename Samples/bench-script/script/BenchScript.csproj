<Project Sdk="Microsoft.NET.Sdk">
  <!-- BenchScript：bench-script 的"用户脚本程序集"（环绕弹幕验收场）。
       经 Collectible ALC 从路径加载（与 Lemon.Entry 无引用关系，分层同 TestScript）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>BenchScript</AssemblyName>
    <RootNamespace>BenchScript</RootNamespace>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Engine/Scripting/dotnet/Lemon.SDK/Lemon.SDK.csproj" />
  </ItemGroup>
</Project>
