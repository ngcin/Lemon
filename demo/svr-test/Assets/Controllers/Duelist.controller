{
  "schemaVersion": 1,
  "name": "Duelist",
  "params": [
    { "name": "speed", "kind": "float" },
    { "name": "attack", "kind": "trigger" },
    { "name": "hit", "kind": "trigger" },
    { "name": "death", "kind": "trigger" }
  ],
  "entry": "Idle",
  "states": ["Idle", "Walk", "Attack", "Hit", "Death"],
  "transitions": [
    { "from": "*", "to": "Death", "when": [{ "trigger": "death" }] },
    { "from": "*", "to": "Hit", "when": [{ "trigger": "hit" }] },
    { "from": "Idle", "to": "Walk", "when": [{ "param": "speed", ">": 0.1 }] },
    { "from": "Walk", "to": "Idle", "when": [{ "param": "speed", "<=": 0.1 }] },
    { "from": "Idle", "to": "Attack", "when": [{ "trigger": "attack" }] },
    { "from": "Walk", "to": "Attack", "when": [{ "trigger": "attack" }] },
    { "from": "Attack", "to": "Idle", "on": "exitTime" },
    { "from": "Hit", "to": "Idle", "on": "exitTime" }
  ],
  "editor": {
    "nodes": {
      "Idle": [0, 96],
      "Walk": [168, 272],
      "Attack": [416, 104],
      "Hit": [0, -48],
      "Death": [464, -160],
      "*": [32, -168]
    }
  }
}
